{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "../src/**/*"],
  "exclude": [
    "../src/**/*.tsx",
    "../src/env.ts",
    "../src/hooks/**/*",
    "../src/lib/fetchBookings.ts",
    "../src/app/**/*"
  ]
}
